# Only what the build needs goes to the builder: the module and its code, and the
# web app without its packages, build or test output. A new top-level directory of
# Go code is added here too.
*
!go.mod
!go.sum
!cmd/
!internal/
!web/
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
