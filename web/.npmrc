# No package's install scripts run (#355): a compromised release of a dependency
# can't run code on `npm ci`. None that installs on Linux has one: the only
# hasInstallScript in package-lock.json is fsevents, optional and macOS-only, which
# works without it. Playwright's browser comes from an
# explicit `npx playwright install`. `npm run <script>` still runs the named
# script, but no pre- or post- script around it.
ignore-scripts=true
