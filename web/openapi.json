{
  "openapi": "3.1.0",
  "info": {
    "title": "Those Who Run: pit wall",
    "version": "1",
    "description": "The pit wall's read-only data API, and the engineer's routes it forwards."
  },
  "paths": {
    "/api/v1/sessions": {
      "get": {
        "operationId": "listSessions",
        "summary": "Sessions, newest first, with the card's facts as values",
        "tags": [
          "pitwall"
        ],
        "parameters": [
          {
            "name": "track",
            "in": "query",
            "required": false,
            "description": "Only sessions with this track name; empty matches all",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "car",
            "in": "query",
            "required": false,
            "description": "Only sessions with this car name; empty matches all",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "description": "Only sessions with this session kind key; empty matches all",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Only sessions started on or after this day, in tz (else the pit wall's zone): \"2026-10-17\"",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Only sessions started on or before this day, in tz (else the pit wall's zone): \"2026-10-17\"",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "tz",
            "in": "query",
            "required": false,
            "description": "The time zone from and to are days in, an IANA name: \"Europe/Dublin\". The browser's own; without it, the pit wall's zone (UTC in its container)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionList"
                }
              }
            }
          },
          "304": {
            "description": "Not modified: nothing has changed since the ETag sent in If-None-Match"
          },
          "400": {
            "description": "A bad parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Unhealthy, or the index is busy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{id}": {
      "get": {
        "operationId": "getSession",
        "summary": "One session",
        "tags": [
          "pitwall"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The session id, \"20261017-162118\"",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "304": {
            "description": "Not modified: nothing has changed since the ETag sent in If-None-Match"
          },
          "404": {
            "description": "No such session, lap or path",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Unhealthy, or the index is busy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{id}/laps": {
      "get": {
        "operationId": "listLaps",
        "summary": "A session's lap table",
        "tags": [
          "pitwall"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The session id, \"20261017-162118\"",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LapList"
                }
              }
            }
          },
          "304": {
            "description": "Not modified: nothing has changed since the ETag sent in If-None-Match"
          },
          "404": {
            "description": "No such session, lap or path",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Unhealthy, or the index is busy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{id}/laps/{lap}/trace": {
      "get": {
        "operationId": "getTrace",
        "summary": "A lap's speed, throttle, brake, gear and RPM against time",
        "tags": [
          "pitwall"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The session id, \"20261017-162118\"",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lap",
            "in": "path",
            "required": true,
            "description": "The lap number",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "points",
            "in": "query",
            "required": false,
            "description": "The most points to send",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1500
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trace"
                }
              }
            }
          },
          "304": {
            "description": "Not modified: nothing has changed since the ETag sent in If-None-Match"
          },
          "400": {
            "description": "A bad parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No such session, lap or path",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Unhealthy, or the index is busy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{id}/same-track": {
      "get": {
        "operationId": "listSameTrack",
        "summary": "The other sessions at this session's track, for lap compare",
        "tags": [
          "pitwall"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The session id, \"20261017-162118\"",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SameTrack"
                }
              }
            }
          },
          "304": {
            "description": "Not modified: nothing has changed since the ETag sent in If-None-Match"
          },
          "404": {
            "description": "No such session, lap or path",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Unhealthy, or the index is busy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "summary": "This schema",
        "tags": [
          "pitwall"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "summary": "The pit wall's health",
        "tags": [
          "pitwall"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Unhealthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/engine/status": {
      "get": {
        "operationId": "getEngineStatus",
        "summary": "What the engineer is doing right now, from its /api/v1/status",
        "tags": [
          "engineer"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EngineStatus"
                }
              }
            }
          },
          "502": {
            "description": "The engineer did not answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "description": "The body of every error response.",
        "properties": {
          "error": {
            "type": "string",
            "description": "What went wrong, in a sentence"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "EngineStatus": {
        "type": "object",
        "description": "What the engineer is doing right now (#292).",
        "properties": {
          "version": {
            "type": "string",
            "description": "The engineer's version"
          },
          "started_at": {
            "type": "number",
            "description": "Unix time the engineer started"
          },
          "activity": {
            "enum": [
              "idle",
              "driving",
              "paused",
              "replay",
              "demo"
            ],
            "description": "What it is doing; idle exactly when its /healthz says idle"
          },
          "idle_secs": {
            "type": "number",
            "description": "Seconds since the last driving frame; 0 while driving"
          },
          "telemetry": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TelemetryLink"
              }
            ],
            "description": "The telemetry feed"
          },
          "voice_connected": {
            "type": "boolean",
            "description": "Joined to the Discord voice channel"
          },
          "session": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LiveSession"
              },
              {
                "type": "null"
              }
            ],
            "description": "The open session; null when none is open"
          }
        },
        "required": [
          "version",
          "started_at",
          "activity",
          "idle_secs",
          "telemetry",
          "voice_connected",
          "session"
        ],
        "additionalProperties": false
      },
      "FilterOption": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "The value, as its query parameter takes it"
          },
          "count": {
            "type": "integer",
            "description": "Sessions this value would leave, with the other filters applied (not its own)"
          }
        },
        "required": [
          "value",
          "count"
        ],
        "additionalProperties": false
      },
      "FilterOptions": {
        "type": "object",
        "description": "The values each filter can take, from every session, each with a count.",
        "properties": {
          "track": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilterOption"
            },
            "description": "Track names, as Session.track.name has them"
          },
          "car": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilterOption"
            },
            "description": "Car names"
          },
          "kind": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KindOption"
            },
            "description": "Session kinds"
          }
        },
        "required": [
          "track",
          "car",
          "kind"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "description": "The pit wall's health: unhealthy only when the data directory can't be read.",
        "properties": {
          "ok": {
            "type": "boolean",
            "description": "The data directory is readable"
          },
          "version": {
            "type": "string",
            "description": "The pit wall's version"
          },
          "index": {
            "type": "boolean",
            "description": "The index exists: false on a new volume until the engineer writes"
          },
          "engineer": {
            "type": "boolean",
            "description": "The engineer answered; down never makes the pit wall unhealthy"
          }
        },
        "required": [
          "ok",
          "version",
          "index",
          "engineer"
        ],
        "additionalProperties": false
      },
      "KindOption": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "The kind key, as ?kind= takes it"
          },
          "label": {
            "type": "string",
            "description": "The kind's name"
          },
          "count": {
            "type": "integer",
            "description": "Sessions this value would leave, with the other filters applied (not its own)"
          }
        },
        "required": [
          "value",
          "label",
          "count"
        ],
        "additionalProperties": false
      },
      "LapList": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "The session"
          },
          "laps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LapRow"
            },
            "description": "Its laps in order"
          }
        },
        "required": [
          "session_id",
          "laps"
        ],
        "additionalProperties": false
      },
      "LapRow": {
        "type": "object",
        "description": "One lap in the lap table.",
        "properties": {
          "lap": {
            "type": "integer",
            "description": "Lap number"
          },
          "time_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Lap time; null for a partial lap or an untimed crossing"
          },
          "complete": {
            "type": "boolean",
            "description": "The lap was driven to the line"
          },
          "fuel_start": {
            "type": [
              "number",
              "null"
            ],
            "description": "Fuel at the lap's start, GT7's units"
          },
          "fuel_end": {
            "type": [
              "number",
              "null"
            ],
            "description": "Fuel at its end"
          },
          "fuel_used": {
            "type": [
              "number",
              "null"
            ],
            "description": "Fuel used over the lap (negative when refuelled)"
          },
          "position": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Position at the line; null where a position means nothing"
          },
          "frames": {
            "type": "integer",
            "description": "Telemetry frames stored for the lap"
          },
          "file": {
            "type": "string",
            "description": "The lap's Parquet file in the session directory"
          },
          "top_speed_kph": {
            "type": [
              "number",
              "null"
            ],
            "description": "Top speed; null when the lap file is missing"
          },
          "pit": {
            "type": "boolean",
            "description": "The in-lap of a pit stop"
          },
          "out_lap": {
            "type": "boolean",
            "description": "The lap after a pit stop"
          },
          "invalid": {
            "type": "boolean",
            "description": "No lap time to compare: a partial lap or an untimed crossing"
          },
          "best": {
            "type": "boolean",
            "description": "The session's best lap, as the card picks it"
          },
          "fuel_use": {
            "type": "boolean",
            "description": "False when the session's fuel use is off: its fuel means nothing"
          },
          "restart": {
            "type": "boolean",
            "description": "An engineer restart fell in this lap (#273): partly seen"
          },
          "clean": {
            "type": "boolean",
            "description": "Counts towards an average: not pit, out, partial or restart (#298)"
          }
        },
        "required": [
          "lap",
          "time_ms",
          "complete",
          "fuel_start",
          "fuel_end",
          "fuel_used",
          "position",
          "frames",
          "file",
          "top_speed_kph",
          "pit",
          "out_lap",
          "invalid",
          "best",
          "fuel_use",
          "restart",
          "clean"
        ],
        "additionalProperties": false
      },
      "LiveSession": {
        "type": "object",
        "description": "The session the engineer has open, as of the last frame.",
        "properties": {
          "id": {
            "type": "string",
            "description": "The session id, as the pit wall lists it: \"20261017-162118\""
          },
          "kind": {
            "enum": [
              "unknown",
              "lap_race",
              "solo_laps",
              "timed_field",
              "solo_timed"
            ],
            "description": "Session kind key (sessionkind.Kind), \"unknown\" until it is known"
          },
          "track": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TrackSeen"
              },
              {
                "type": "null"
              }
            ],
            "description": "Where it is being driven; null until the detector has a match"
          },
          "car": {
            "type": [
              "string",
              "null"
            ],
            "description": "The car's name; null when GT7 sent no car code"
          },
          "lap": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The lap of the last driving frame"
          },
          "laps_total": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Laps in the race; null for a timed session"
          },
          "position": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Position now; null where the results card hides it"
          },
          "cars": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Cars in the field; null where the results card hides the position"
          }
        },
        "required": [
          "id",
          "kind",
          "track",
          "car",
          "lap",
          "laps_total",
          "position",
          "cars"
        ],
        "additionalProperties": false
      },
      "SameTrack": {
        "type": "object",
        "properties": {
          "sessions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Session"
            },
            "description": "Other sessions at the same track, newest first"
          }
        },
        "required": [
          "sessions"
        ],
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "description": "One session: what its results card is built from, as values.",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "The session id, \"20261017-162118\""
          },
          "title": {
            "type": "string",
            "description": "The results card title, \"Circuit Gilles Villeneuve · 12-lap race\""
          },
          "result": {
            "type": "string",
            "description": "The results card line, \"🚩 Finished P3 of 20 in 21:06.182\""
          },
          "started_at": {
            "type": "number",
            "description": "Unix time the session started"
          },
          "ended_at": {
            "type": [
              "number",
              "null"
            ],
            "description": "Unix time it ended; null while it is still open"
          },
          "closed": {
            "type": "boolean",
            "description": "summary.json is written: the session has ended"
          },
          "kind": {
            "type": "string",
            "description": "Session kind key (sessionkind.Kind), \"unknown\" when not recorded"
          },
          "kind_label": {
            "type": "string",
            "description": "The kind as the card names it: \"12-lap race\", \"time trial\""
          },
          "track": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Track"
              }
            ],
            "description": "Where it was driven"
          },
          "car": {
            "type": [
              "string",
              "null"
            ],
            "description": "The car's name, null when GT7 sent an unknown code"
          },
          "car_code": {
            "type": [
              "integer",
              "null"
            ],
            "description": "GT7's car code"
          },
          "finished": {
            "type": "boolean",
            "description": "The race was finished: GT7 showed the result"
          },
          "final_position": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Position at the end; show it only if position_shown"
          },
          "total_cars": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Cars in the field"
          },
          "position_shown": {
            "type": "boolean",
            "description": "A position means something here: a field GT7 flags"
          },
          "total_time_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Race time of a finished race"
          },
          "best_lap_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The best lap as the card picks it (GT7's own best first)"
          },
          "best_lap_no": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Which lap that was"
          },
          "laps_completed": {
            "type": "integer",
            "description": "Laps completed"
          },
          "total_laps": {
            "type": "integer",
            "description": "Laps in the race; 0 for a timed or open session"
          },
          "fuel_use": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Fuel use is on; false means the fuel figures mean nothing"
          },
          "fuel_used": {
            "type": [
              "number",
              "null"
            ],
            "description": "Fuel burned over the session, in GT7's units (refuels left out)"
          },
          "fuel_capacity": {
            "type": [
              "number",
              "null"
            ],
            "description": "The tank, in GT7's units: fuel as a share of it"
          },
          "fuel_by_stint": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Fuel burned in each stint, as the card's fuel line has it"
          },
          "pit_stops": {
            "type": "integer",
            "description": "Pit stops made"
          },
          "driving_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Time not paused (#229); null for older and open sessions"
          },
